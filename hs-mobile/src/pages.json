    {
      "path": "pages/mine/cert",
      "style": {
        "navigationBarTitleText": "我的资质"
      }
    },
    {
      "path": "pages/mine/auth",
      "style": {
        "navigationBarTitleText": "我的授权"
      }
    },
    {
      "path": "pages/notice/list",
      "style": {
        "navigationBarTitleText": "系统公告",
        "enablePullDownRefresh": true
      }
    },
    {
      "path": "pages/notice/detail",
      "style": {
        "navigationBarTitleText": "公告详情"
      }
    },
    {
      "path": "pages/out/progress",
      "style": {
        "navigationBarTitleText": "检测进度查询"
      }
