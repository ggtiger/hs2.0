{
  "easycom": {
    "autoscan": true,
    "custom": {
      "^(state-tag|stat-card|search-bar|empty-state|todo-card|approve-bar|approver-picker|record-template|tpl-node)$": "@/components/$1.vue",
      "^uv-(.*)$": "@climblee/uv-ui/components/uv-$1/uv-$1.vue"
    }
  },
  "pages": [
    {
      "path": "pages/index/index",
      "style": {
        "navigationBarTitleText": "工作台",
        "enablePullDownRefresh": true,
        "navigationStyle": "custom"
      }
    },
    {
      "path": "pages/todo/list",
      "style": {
        "navigationBarTitleText": "待办中心",
        "enablePullDownRefresh": true
      }
    },
    {
      "path": "pages/scan/index",
      "style": {
        "navigationBarTitleText": "扫一扫"
      }
    },
    {
      "path": "pages/query/index",
      "style": {
        "navigationBarTitleText": "业务查询"
      }
    },
    {
      "path": "pages/mine/index",
      "style": {
        "navigationBarTitleText": "我的",
        "navigationStyle": "custom"
      }
    },
    {
      "path": "pages/login/index",
      "style": {
        "navigationBarTitleText": "登录",
        "navigationStyle": "custom"
      }
    },
    {
      "path": "pages/approve/list",
      "style": {
        "navigationBarTitleText": "审批列表",
        "enablePullDownRefresh": true
      }
    },
    {
      "path": "pages/approve/detail",
      "style": {
        "navigationBarTitleText": "审批详情"
      }
    },
    {
      "path": "pages/approve/batch",
