        "enablePullDownRefresh": true
      }
    },
    {
      "path": "pages/query/record",
      "style": {
        "navigationBarTitleText": "原始记录查询",
        "enablePullDownRefresh": true
      }
    },
    {
      "path": "pages/query/cert",
      "style": {
        "navigationBarTitleText": "证书查询",
        "enablePullDownRefresh": true
      }
    },
    {
      "path": "pages/query/accept",
      "style": {
        "navigationBarTitleText": "受理单查询",
        "enablePullDownRefresh": true
      }
    },
    {
      "path": "pages/query/fee",
