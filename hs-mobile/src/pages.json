  "globalStyle": {
    "navigationBarTextStyle": "white",
    "navigationBarTitleText": "睿谱希",
    "navigationBarBackgroundColor": "#2f7df6",
    "backgroundColor": "#F8F8F8",
    "backgroundColorTop": "#2f7df6",
    "backgroundColorBottom": "#F8F8F8"
  },
  "tabBar": {
    "color": "#7A7E83",
    "selectedColor": "#2f7df6",
    "borderStyle": "black",
    "backgroundColor": "#FFFFFF",
    "list": [
      {
        "pagePath": "pages/index/index",
        "text": "工作台",
        "iconPath": "static/icons/home.png",
        "selectedIconPath": "static/icons/home-active.png"
      },
      {
        "pagePath": "pages/todo/list",
        "text": "待办",
        "iconPath": "static/icons/todo.png",
        "selectedIconPath": "static/icons/todo-active.png"
      },
      {
        "pagePath": "pages/scan/index",
        "text": "扫码",
        "iconPath": "static/icons/scan.png",
        "selectedIconPath": "static/icons/scan-active.png"
      },
      {
        "pagePath": "pages/query/index",
        "text": "查询",
        "iconPath": "static/icons/query.png",
        "selectedIconPath": "static/icons/query-active.png"
      },
      {
        "pagePath": "pages/mine/index",
        "text": "我的",
        "iconPath": "static/icons/mine.png",
        "selectedIconPath": "static/icons/mine-active.png"
      }
    ]
  },
  "condition": {
    "current": 0,
    "list": [
      {
        "name": "工作台",
        "path": "pages/index/index"
      },
      {
        "name": "待办",
        "path": "pages/todo/list"
      },
      {
        "name": "证书验证(外部)",
        "path": "pages/out/verify"
      }
    ]
  }
}
